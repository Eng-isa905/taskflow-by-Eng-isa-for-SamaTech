# Copy to .env and set SESSION_SECRET and SETUP_TOKEN using START-HERE-AR.md.
# Never commit .env or share the generated secrets.
HOST_PORT=3001
PORT=3000
NODE_ENV=production
DB_PATH=/app/data/taskflow.sqlite
SESSION_SECRET=
SETUP_TOKEN=
# false for local http://localhost; set true when serving behind HTTPS.
COOKIE_SECURE=false
# Set true only when TaskFlow is behind a trusted reverse proxy you control.
TRUST_PROXY=false
